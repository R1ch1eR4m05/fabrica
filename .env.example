# Copia este archivo como ".env" y llena lo que tengas. No lo compartas nunca.

# Opcional. OJO: la API de Claude se cobra APARTE de tu suscripción (pago por uso en console.anthropic.com).
# Si la dejas vacía, guiones e investigación los hace Claude Code con tu plan normal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Voz (sin esto se usa una voz de prueba muda para ensayar)
ELEVENLABS_API_KEY=
# voz por defecto (la usa cualquier estilo que no tenga la suya)
ELEVENLABS_VOICE_ID=
# voz por estilo (opcional): VOZ_ + id del estilo en mayúsculas con guiones bajos
VOZ_TERROR_LINTERNA=
VOZ_FRASES_DESENFOCADO=
# modelo de voz por defecto (en el panel se elige por estilo):
#   eleven_v4 (la más expresiva) · eleven_v4_turbo (mitad de precio) · eleven_multilingual_v2 · eleven_flash_v2_5 (mitad de precio)
#   google_chirp3 (Google Cloud TTS Chirp 3 HD: casi gratis; necesita GOOGLE_TTS_KEY)
ELEVENLABS_MODEL=eleven_multilingual_v2
# Google Cloud Text-to-Speech (opcional): llave de API con "Cloud Text-to-Speech API" activada
GOOGLE_TTS_KEY=
# voz de Google: es-US-Chirp3-HD-<Nombre> (Charon, Orus, Puck, Kore, Aoede…) · velocidad 0.8–1.2
GOOGLE_TTS_VOZ=es-US-Chirp3-HD-Charon
GOOGLE_TTS_VELOCIDAD=1

# Gemini GRATIS (sin tarjeta): https://aistudio.google.com/apikey  → convierte informes en propuestas y escribe con límites diarios
GEMINI_API_KEY=
# si uno está saturado se prueba el siguiente
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest,gemini-2.5-flash

# Clips de fondo para "Frases" (cualquiera de los dos; Pexels pausó llaves nuevas)
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Investigador de virales: métricas reales de TikTok e Instagram (https://console.apify.com → Settings → API & Integrations)
# Sin esto, investiga con búsqueda web (sin vistas/guardados exactos). Apify cobra por resultado (centavos por investigación).
APIFY_TOKEN=

# flow-mcp (Google Flow). Solo si lo instalaste aparte; esta es su dirección por defecto
FLOW_MCP_URL=http://127.0.0.1:8787

# APIMart: imágenes y video con IA (para los estilos que vienen: animación 3D, imágenes por escena)
APIMART_API_KEY=

# Panel
HOST=127.0.0.1
PORT=4870
# En el VPS: HOST=0.0.0.0 y pon una clave (usuario: cualquiera, contraseña: esta)
PANEL_CLAVE=

# Render
RENDER_HILOS=4
FPS=30
# Rutas opcionales si quieres usar otro navegador o ffmpeg
CHROME_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# GoHighLevel (programar los videos en el Social Planner). En tu subcuenta: Configuración → Integraciones privadas → Crear.
# Permisos: medias.write, medias.readonly, socialplanner/post.write, socialplanner/post.readonly, socialplanner/account.readonly
GHL_TOKEN=
GHL_LOCATION_ID=
# tu id de usuario en GHL (quién crea la publicación). Si lo dejas vacío la fábrica lo busca sola (necesita el permiso users.readonly); si no, sácalo de Settings → My Staff → tu usuario
GHL_USER_ID=

# Google Flow Skill (https://github.com/BRPLia/google-flow-skill-v1): genera los clips de Flow desde tu laptop.
# Carpeta donde clonaste la skill (la que tiene flow.py). Instalación: python setup.py  y  python flow.py login
FLOW_SKILL_DIR=
# opcional si "python" no es el comando correcto
PYTHON=

# Solo en la LAPTOP: manda al VPS cada imagen del banco y cada música generada (para usarlas desde el celular).
# ESPEJO_URL = la dirección del panel del VPS que abres en el celular (la de Tailscale, https://…ts.net)
# ESPEJO_CLAVE = el PANEL_CLAVE del VPS. La laptop necesita Tailscale encendido.
ESPEJO_URL=
ESPEJO_CLAVE=
# Más fácil (sin Tailscale): en la LAPTOP corre una vez "Conectar al VPS (Windows).cmd" (o node fabrica.js conectar-vps root@IP).
# Deja VPS_SSH y ESPEJO_* puestos: al abrir la fábrica se abre sola un túnel SSH (laptop 4871 → VPS, VPS 4872 → laptop).
# VPS_SSH=root@IP-DEL-VPS

# --- Solo en el VPS: pedirle Flow a la laptop por Tailscale (botón "Generar en la laptop") ---
# La laptop necesita en su .env HOST=127.0.0.1,<su IP de Tailscale> y PANEL_CLAVE=<clave>; aquí va esa misma clave.
# LAPTOP_URL=http://100.x.x.x:4870
# LAPTOP_CLAVE=
